-- Migration 3 -> 4 (2026-11-23, B3). Adds notes: free text the person writes from quick
-- add, the timeline and Today. A note is a layer-4 row with full provenance
-- (pr.md §6.27, §7.4) and references source and raw_record, so the two existing foreign
-- key rules apply unchanged: SET NULL on an optional provenance link.

CREATE TABLE note (
    id TEXT NOT NULL PRIMARY KEY,
    body TEXT NOT NULL,
    local_date TEXT NOT NULL,
    zone_id TEXT NOT NULL,
    happened_at INTEGER NOT NULL,
    recorded_at INTEGER NOT NULL,
    edited_at INTEGER,
    source_id TEXT REFERENCES source(id) ON DELETE SET NULL,
    raw_record_id TEXT REFERENCES raw_record(id) ON DELETE SET NULL,
    idempotency_key TEXT NOT NULL UNIQUE,
    device TEXT,
    app_version TEXT,
    revision INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX note_local_date ON note(local_date);
CREATE INDEX note_happened_at ON note(happened_at);
