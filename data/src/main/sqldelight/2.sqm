-- session
CREATE TABLE session_carry_v3 AS SELECT id, started_at, ended_at, local_date, zone_id, happened_at, recorded_at, routine_id, programme_id, notes, source_id, idempotency_key, observation_id, raw_record_id, device, app_version, revision, updated_at FROM session;
DROP TABLE session;
CREATE TABLE session (
    id TEXT NOT NULL PRIMARY KEY,
    started_at INTEGER NOT NULL,
    ended_at INTEGER,
    local_date TEXT NOT NULL,
    zone_id TEXT NOT NULL,
    happened_at INTEGER NOT NULL,
    recorded_at INTEGER NOT NULL,
    routine_id TEXT REFERENCES routine(id) ON DELETE SET NULL,
    programme_id TEXT REFERENCES programme(id) ON DELETE SET NULL,
    notes TEXT,
    source_id TEXT NOT NULL REFERENCES source(id) ON DELETE RESTRICT,
    idempotency_key TEXT NOT NULL UNIQUE,
    observation_id TEXT REFERENCES observation(id) ON DELETE SET NULL,
    raw_record_id TEXT REFERENCES raw_record(id) ON DELETE SET NULL,
    device TEXT,
    app_version TEXT,
    revision INTEGER NOT NULL DEFAULT 1,
    updated_at INTEGER NOT NULL
);
INSERT INTO session (id, started_at, ended_at, local_date, zone_id, happened_at, recorded_at, routine_id, programme_id, notes, source_id, idempotency_key, observation_id, raw_record_id, device, app_version, revision, updated_at) SELECT id, started_at, ended_at, local_date, zone_id, happened_at, recorded_at, routine_id, programme_id, notes, source_id, idempotency_key, observation_id, raw_record_id, device, app_version, revision, updated_at FROM session_carry_v3;
DROP TABLE session_carry_v3;
CREATE INDEX session_local_date ON session(local_date);
CREATE INDEX session_happened ON session(happened_at);

-- session_exercise
CREATE TABLE session_exercise_carry_v3 AS SELECT id, session_id, exercise_id, position, notes FROM session_exercise;
DROP TABLE session_exercise;
CREATE TABLE session_exercise (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL REFERENCES session(id) ON DELETE RESTRICT,
    exercise_id TEXT NOT NULL REFERENCES exercise(id) ON DELETE RESTRICT,
    position INTEGER NOT NULL,
    notes TEXT
);
INSERT INTO session_exercise (id, session_id, exercise_id, position, notes) SELECT id, session_id, exercise_id, position, notes FROM session_exercise_carry_v3;
DROP TABLE session_exercise_carry_v3;
