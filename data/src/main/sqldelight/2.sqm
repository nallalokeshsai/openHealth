-- work_set
CREATE TABLE work_set_carry_v3 AS SELECT id, session_id, session_exercise_id, exercise_id, position, weight_kg, reps, rir, rpe, is_warmup, is_backoff, is_failure, is_bodyweight, tempo, rest_seconds, completed_at, happened_at, recorded_at, source_id, idempotency_key, observation_id, raw_record_id, device, app_version, revision FROM work_set;
