    reps INTEGER NOT NULL,
    rir REAL,
    rpe REAL,
    is_warmup INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    is_backoff INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    is_failure INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    is_bodyweight INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    tempo TEXT,
    rest_seconds INTEGER,
    completed_at INTEGER NOT NULL,
    happened_at INTEGER NOT NULL,
    recorded_at INTEGER NOT NULL,
    source_id TEXT NOT NULL REFERENCES source(id) ON DELETE RESTRICT,
    idempotency_key TEXT NOT NULL UNIQUE,
    observation_id TEXT REFERENCES observation(id) ON DELETE SET NULL,
    raw_record_id TEXT REFERENCES raw_record(id) ON DELETE SET NULL,
    device TEXT,
    app_version TEXT,
    revision INTEGER NOT NULL DEFAULT 1
);
INSERT INTO work_set (id, session_id, session_exercise_id, exercise_id, position, weight_kg, reps, rir, rpe, is_warmup, is_backoff, is_failure, is_bodyweight, tempo, rest_seconds, completed_at, happened_at, recorded_at, source_id, idempotency_key, observation_id, raw_record_id, device, app_version, revision) SELECT id, session_id, session_exercise_id, exercise_id, position, weight_kg, reps, rir, rpe, is_warmup, is_backoff, is_failure, is_bodyweight, tempo, rest_seconds, completed_at, happened_at, recorded_at, source_id, idempotency_key, observation_id, raw_record_id, device, app_version, revision FROM work_set_carry_v3;
