-- Migration 2 -> 3 (2026-11-23, post-B2 review). Declares the referential integrity
-- the v2 schema only implied: every source_id, raw_record_id, observation_id, meal_id,
-- food_id and training parent is now a real foreign key. SQLite cannot add a constraint
-- with ALTER TABLE, so each affected table is rebuilt.
--
-- A structural parent is RESTRICT, so a delete must go through TrashService and write a
-- tombstone for the children rather than cascade silently (pr.md §6.29). An optional
-- provenance link is SET NULL, so compacting a raw record or deleting a meal leaves the
-- value and its own provenance intact (pr.md §7.1).
--
-- Three constraints shape how this is written:
--   * DatabaseOpener turns foreign keys OFF around the migration and runs
--     PRAGMA foreign_key_check afterwards, so copy order does not matter.
--   * No ALTER TABLE RENAME is used, so the schema is never reparsed while a referenced
--     table is missing.
--   * Columns are listed explicitly. SQLDelight drops the `*` from `SELECT *` when it
--     emits migration SQL, so a star here would reach SQLite as `SELECT  FROM`.
-- The carry tables are ordinary tables, not TEMP ones: TEMP is per-connection and the
-- driver does not promise one connection for the whole migration.


-- raw_record
CREATE TABLE raw_record_carry_v3 AS SELECT id, source_id, source_kind, device, app_version, received_at, recorded_at, happened_at, payload_hash, payload_ref, payload, idempotency_key, schema_version, compacted_at FROM raw_record;
DROP TABLE raw_record;
CREATE TABLE raw_record (
    id TEXT NOT NULL PRIMARY KEY,
    source_id TEXT NOT NULL REFERENCES source(id) ON DELETE RESTRICT,
    source_kind TEXT NOT NULL,
    device TEXT,
    app_version TEXT,
    received_at INTEGER NOT NULL,
    recorded_at INTEGER NOT NULL,
    happened_at INTEGER,
    payload_hash TEXT NOT NULL,
    payload_ref TEXT,
    payload TEXT,
    idempotency_key TEXT NOT NULL UNIQUE,
    schema_version INTEGER NOT NULL,
    compacted_at INTEGER
);
INSERT INTO raw_record (id, source_id, source_kind, device, app_version, received_at, recorded_at, happened_at, payload_hash, payload_ref, payload, idempotency_key, schema_version, compacted_at) SELECT id, source_id, source_kind, device, app_version, received_at, recorded_at, happened_at, payload_hash, payload_ref, payload, idempotency_key, schema_version, compacted_at FROM raw_record_carry_v3;
DROP TABLE raw_record_carry_v3;
CREATE INDEX raw_record_received ON raw_record(received_at);
CREATE INDEX raw_record_hash ON raw_record(payload_hash);

-- observation
CREATE TABLE observation_carry_v3 AS SELECT id, type, value, unit, start_at, end_at, local_date, zone_id, happened_at, recorded_at, source_id, device, app_version, method, context, confidence, quality, user_verified, user_edited, original_value, original_unit, edit_reason, edited_at, group_key, excluded_from_trends, idempotency_key, raw_record_id FROM observation;
DROP TABLE observation;
CREATE TABLE observation (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    value REAL NOT NULL,
    unit TEXT NOT NULL,
    start_at INTEGER NOT NULL,
    end_at INTEGER,
    local_date TEXT NOT NULL,
    zone_id TEXT NOT NULL,
    happened_at INTEGER NOT NULL,
    recorded_at INTEGER NOT NULL,
    source_id TEXT NOT NULL REFERENCES source(id) ON DELETE RESTRICT,
    device TEXT,
    app_version TEXT,
    method TEXT,
    context TEXT,
    confidence REAL,
    quality TEXT,
    user_verified INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    user_edited INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    original_value REAL,
    original_unit TEXT,
    edit_reason TEXT,
    edited_at INTEGER,
    group_key TEXT,
    excluded_from_trends INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    idempotency_key TEXT NOT NULL UNIQUE,
    raw_record_id TEXT REFERENCES raw_record(id) ON DELETE SET NULL
);
INSERT INTO observation (id, type, value, unit, start_at, end_at, local_date, zone_id, happened_at, recorded_at, source_id, device, app_version, method, context, confidence, quality, user_verified, user_edited, original_value, original_unit, edit_reason, edited_at, group_key, excluded_from_trends, idempotency_key, raw_record_id) SELECT id, type, value, unit, start_at, end_at, local_date, zone_id, happened_at, recorded_at, source_id, device, app_version, method, context, confidence, quality, user_verified, user_edited, original_value, original_unit, edit_reason, edited_at, group_key, excluded_from_trends, idempotency_key, raw_record_id FROM observation_carry_v3;
DROP TABLE observation_carry_v3;
CREATE INDEX observation_local_date ON observation(local_date);
CREATE INDEX observation_type_happened ON observation(type, happened_at);
CREATE INDEX observation_type_local_date ON observation(type, local_date);
CREATE INDEX observation_happened ON observation(happened_at);
CREATE INDEX observation_source_date ON observation(source_id, local_date);

