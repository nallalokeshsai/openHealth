    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    date_of_birth TEXT,
    sex_at_birth TEXT,
    gender TEXT,
    height_cm REAL,
    weight_kg REAL,
    units TEXT NOT NULL,
    zone_id TEXT NOT NULL,
    language TEXT NOT NULL,
    goal TEXT,
    activity_level TEXT,
    training_experience TEXT,
    weight_neutral INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    intake_tier INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    source_id TEXT REFERENCES source(id) ON DELETE SET NULL,
    revision INTEGER NOT NULL DEFAULT 1
);
INSERT INTO profile (id, name, date_of_birth, sex_at_birth, gender, height_cm, weight_kg, units, zone_id, language, goal, activity_level, training_experience, weight_neutral, intake_tier, created_at, updated_at, source_id, revision) SELECT id, name, date_of_birth, sex_at_birth, gender, height_cm, weight_kg, units, zone_id, language, goal, activity_level, training_experience, weight_neutral, intake_tier, created_at, updated_at, source_id, revision FROM profile_carry_v3;
