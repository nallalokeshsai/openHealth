);
INSERT INTO daily_rollup (local_date, type, value, unit, secondary_value, source_id, contributing_sources, dedup_reason, watermark, computed_at, detail) SELECT local_date, type, value, unit, secondary_value, source_id, contributing_sources, dedup_reason, watermark, computed_at, detail FROM daily_rollup_carry_v3;
DROP TABLE daily_rollup_carry_v3;
CREATE INDEX daily_rollup_date ON daily_rollup(local_date);

