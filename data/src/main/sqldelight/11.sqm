-- B15 (schema v12): the coach's conversation, proposals and before-snapshots, plus the
-- local MCP tokens and their access audit. `pr.md` §6.15, §6.30; `Tech-Stack.md` §9.
--
-- Provenance: a proposal is not a measurement, so it carries no observation provenance;
-- the plan rows it changes keep theirs. Every row here is device-local: the coach history
-- and MCP credentials are never synced (`SyncTables.neverSynced`).

ALTER TABLE source ADD COLUMN via_health_connect INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0;

CREATE TABLE IF NOT EXISTS coach_message (
    id TEXT NOT NULL PRIMARY KEY,
    thread_id TEXT NOT NULL,
    role TEXT NOT NULL,
    body TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    provider TEXT,
    model TEXT,
    input_tokens INTEGER,
    output_tokens INTEGER,
    proposal_id TEXT,
    error_key TEXT,
    repaired INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    revision INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX IF NOT EXISTS coach_message_thread ON coach_message(thread_id, created_at);

CREATE TABLE IF NOT EXISTS coach_proposal (
    id TEXT NOT NULL PRIMARY KEY,
    message_id TEXT NOT NULL REFERENCES coach_message(id) ON DELETE RESTRICT,
    summary TEXT NOT NULL,
    rationale TEXT NOT NULL,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    decided_at INTEGER,
    revision INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX IF NOT EXISTS coach_proposal_status ON coach_proposal(status, created_at);

CREATE TABLE IF NOT EXISTS coach_action (
    id TEXT NOT NULL PRIMARY KEY,
    proposal_id TEXT NOT NULL REFERENCES coach_proposal(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    kind TEXT NOT NULL,
    payload TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS coach_action_proposal ON coach_action(proposal_id, position);

CREATE TABLE IF NOT EXISTS coach_snapshot (
    id TEXT NOT NULL PRIMARY KEY,
    proposal_id TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    payload TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS coach_snapshot_proposal ON coach_snapshot(proposal_id);

CREATE TABLE IF NOT EXISTS mcp_token (
    id TEXT NOT NULL PRIMARY KEY,
    label TEXT NOT NULL,
    scopes TEXT NOT NULL,
    token_hash TEXT NOT NULL UNIQUE,
    created_at INTEGER NOT NULL,
    revoked_at INTEGER,
    last_used_at INTEGER
);

CREATE TABLE IF NOT EXISTS mcp_access (
    id TEXT NOT NULL PRIMARY KEY,
    token_id TEXT,
    tool TEXT NOT NULL,
    scope TEXT,
    at INTEGER NOT NULL,
    ok INTEGER AS kotlin.Boolean NOT NULL,
    detail TEXT
);

CREATE INDEX IF NOT EXISTS mcp_access_at ON mcp_access(at);
