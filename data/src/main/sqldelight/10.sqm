-- B13 (schema v11): the change log, the per-row merge state and the conflict queue.
-- `pr.md` §7.7; `Tech-Stack.md` §6.

CREATE TABLE IF NOT EXISTS change_log (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    entity TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    operation TEXT NOT NULL,
    fields TEXT NOT NULL,
    field_clocks TEXT NOT NULL,
    idempotency_key TEXT NOT NULL UNIQUE,
    hlc TEXT NOT NULL,
    device_id TEXT NOT NULL,
    schema_version INTEGER NOT NULL,
    local_date TEXT,
    recorded_at INTEGER NOT NULL,
    synced_at INTEGER,
    server_seq INTEGER
);

CREATE INDEX IF NOT EXISTS change_log_pending ON change_log(synced_at, seq);
CREATE INDEX IF NOT EXISTS change_log_entity ON change_log(entity, entity_id);

CREATE TABLE IF NOT EXISTS sync_row_state (
    entity TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    hlc TEXT NOT NULL,
    field_clocks TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (entity, entity_id)
);

CREATE TABLE IF NOT EXISTS sync_conflict (
    id TEXT NOT NULL PRIMARY KEY,
    entity TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    local_change TEXT NOT NULL,
    remote_change TEXT NOT NULL,
    reason TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS sync_conflict_entity ON sync_conflict(entity, entity_id);
