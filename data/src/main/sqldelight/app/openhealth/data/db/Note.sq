-- Layer 4: a free-text note (pr.md §6.27). A note is a value the person wrote, so it
-- carries the same provenance as an observation but no type and no unit. It appears in
-- the timeline and is only removed through TrashService, like every other row.

CREATE TABLE note (
    id TEXT NOT NULL PRIMARY KEY,
    body TEXT NOT NULL,
    local_date TEXT NOT NULL,
    zone_id TEXT NOT NULL,
    happened_at INTEGER NOT NULL,
    recorded_at INTEGER NOT NULL,
    edited_at INTEGER,
    source_id TEXT REFERENCES source(id) ON DELETE SET NULL,
    raw_record_id TEXT REFERENCES raw_record(id) ON DELETE SET NULL,
    idempotency_key TEXT NOT NULL UNIQUE,
    device TEXT,
    app_version TEXT,
    revision INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX note_local_date ON note(local_date);
CREATE INDEX note_happened_at ON note(happened_at);

insertNote:
INSERT OR IGNORE INTO note(
    id, body, local_date, zone_id, happened_at, recorded_at, edited_at, source_id,
    raw_record_id, idempotency_key, device, app_version, revision
) VALUES (
    :id, :body, :localDate, :zoneId, :happenedAt, :recordedAt, :editedAt, :sourceId,
    :rawRecordId, :idempotencyKey, :device, :appVersion, :revision
);

noteById:
SELECT * FROM note WHERE id = :id;

notesForDay:
SELECT * FROM note WHERE local_date = :localDate ORDER BY happened_at DESC, id;

latestNotes:
SELECT * FROM note ORDER BY happened_at DESC, id LIMIT :limit;

countNotes:
SELECT count(*) FROM note;

deleteNote:
DELETE FROM note WHERE id = :id;

-- No deleteProfile-style escape hatch: deleteNote is called only by TrashService, after
-- the tombstone holds the row (pr.md §6.29).
