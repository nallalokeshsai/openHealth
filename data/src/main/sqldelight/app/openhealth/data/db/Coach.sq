-- The coach's conversation and approved proposals (B15, pr.md §6.15).
-- A message is append-only. A proposal's status changes once; its before-snapshot is
-- what Undo restores. None of it syncs: the coach is this device's conversation.

CREATE TABLE coach_message (
    id TEXT NOT NULL PRIMARY KEY,
    thread_id TEXT NOT NULL,
    role TEXT NOT NULL,
    body TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    provider TEXT,
    model TEXT,
    input_tokens INTEGER,
    output_tokens INTEGER,
    proposal_id TEXT,
    error_key TEXT,
    repaired INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    revision INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX coach_message_thread ON coach_message(thread_id, created_at);

CREATE TABLE coach_proposal (
    id TEXT NOT NULL PRIMARY KEY,
    message_id TEXT NOT NULL REFERENCES coach_message(id) ON DELETE RESTRICT,
    summary TEXT NOT NULL,
    rationale TEXT NOT NULL,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    decided_at INTEGER,
    revision INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX coach_proposal_status ON coach_proposal(status, created_at);

CREATE TABLE coach_action (
    id TEXT NOT NULL PRIMARY KEY,
    proposal_id TEXT NOT NULL REFERENCES coach_proposal(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    kind TEXT NOT NULL,
    payload TEXT NOT NULL
);

CREATE INDEX coach_action_proposal ON coach_action(proposal_id, position);

CREATE TABLE coach_snapshot (
    id TEXT NOT NULL PRIMARY KEY,
    proposal_id TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    payload TEXT NOT NULL
);

CREATE INDEX coach_snapshot_proposal ON coach_snapshot(proposal_id);

insertMessage:
INSERT INTO coach_message(
    id, thread_id, role, body, created_at, provider, model, input_tokens, output_tokens,
    proposal_id, error_key, repaired, revision
) VALUES (
    :id, :threadId, :role, :body, :createdAt, :provider, :model, :inputTokens,
    :outputTokens, :proposalId, :errorKey, :repaired, 1
);

messagesForThread:
SELECT * FROM coach_message WHERE thread_id = :threadId ORDER BY created_at, id;

countMessages:
SELECT count(*) FROM coach_message;

insertProposal:
INSERT INTO coach_proposal(
    id, message_id, summary, rationale, status, created_at, decided_at, revision
) VALUES (
    :id, :messageId, :summary, :rationale, :status, :createdAt, NULL, 1
);

proposalById:
SELECT * FROM coach_proposal WHERE id = :id;

proposalsForMessage:
SELECT * FROM coach_proposal WHERE message_id = :messageId ORDER BY created_at, id;

recentProposals:
SELECT * FROM coach_proposal ORDER BY created_at DESC, rowid DESC LIMIT :limit;

decideProposal:
UPDATE coach_proposal
SET status = :status, decided_at = :decidedAt, revision = revision + 1
WHERE id = :id;

insertAction:
INSERT INTO coach_action(id, proposal_id, position, kind, payload)
VALUES (:id, :proposalId, :position, :kind, :payload);

actionsForProposal:
SELECT * FROM coach_action WHERE proposal_id = :proposalId ORDER BY position;

insertSnapshot:
INSERT INTO coach_snapshot(id, proposal_id, created_at, payload)
VALUES (:id, :proposalId, :createdAt, :payload);

latestAcceptedProposal:
SELECT * FROM coach_proposal WHERE status = 'accepted' ORDER BY decided_at DESC, rowid DESC LIMIT 1;

snapshotForProposal:
SELECT * FROM coach_snapshot WHERE proposal_id = :proposalId ORDER BY created_at DESC LIMIT 1;
