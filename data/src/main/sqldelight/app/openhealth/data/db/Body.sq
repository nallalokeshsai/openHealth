-- Layer 4 body and vital objects (pr.md §6.8, §6.9, §7.4). A measurement is a tape or
-- scale value; a vital is a clinical reading. Both keep provenance and a local day so
-- the timeline shows them next to observations.

CREATE TABLE measurement (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    value REAL NOT NULL,
    unit TEXT NOT NULL,
    local_date TEXT NOT NULL,
    zone_id TEXT NOT NULL,
    happened_at INTEGER NOT NULL,
    recorded_at INTEGER NOT NULL,
    source_id TEXT NOT NULL REFERENCES source(id) ON DELETE RESTRICT,
    method TEXT,
    notes TEXT,
    excluded_from_trends INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    observation_id TEXT REFERENCES observation(id) ON DELETE SET NULL,
    raw_record_id TEXT REFERENCES raw_record(id) ON DELETE SET NULL,
    idempotency_key TEXT NOT NULL UNIQUE,
    device TEXT,
    app_version TEXT,
    revision INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX measurement_local_date ON measurement(local_date);
CREATE INDEX measurement_happened ON measurement(happened_at);
CREATE INDEX measurement_type_happened ON measurement(type, happened_at);

CREATE TABLE vital (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    value REAL NOT NULL,
    unit TEXT NOT NULL,
    local_date TEXT NOT NULL,
    zone_id TEXT NOT NULL,
    happened_at INTEGER NOT NULL,
    recorded_at INTEGER NOT NULL,
    source_id TEXT NOT NULL REFERENCES source(id) ON DELETE RESTRICT,
    method TEXT,
    context TEXT,
    note TEXT,
    excluded_from_trends INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    observation_id TEXT REFERENCES observation(id) ON DELETE SET NULL,
    raw_record_id TEXT REFERENCES raw_record(id) ON DELETE SET NULL,
    idempotency_key TEXT NOT NULL UNIQUE,
    device TEXT,
    app_version TEXT,
    revision INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX vital_local_date ON vital(local_date);
CREATE INDEX vital_happened ON vital(happened_at);
CREATE INDEX vital_type_happened ON vital(type, happened_at);

insertMeasurement:
INSERT OR IGNORE INTO measurement(
    id, type, value, unit, local_date, zone_id, happened_at, recorded_at, source_id,
    method, notes, excluded_from_trends, observation_id, raw_record_id, idempotency_key,
    device, app_version, revision
) VALUES (
    :id, :type, :value, :unit, :localDate, :zoneId, :happenedAt, :recordedAt, :sourceId,
    :method, :notes, :excludedFromTrends, :observationId, :rawRecordId, :idempotencyKey,
    :device, :appVersion, :revision
);

measurementById:
SELECT * FROM measurement WHERE id = :id;

measurementsForDay:
SELECT * FROM measurement WHERE local_date = :localDate ORDER BY happened_at;

measurementsForTypeBetween:
SELECT * FROM measurement
WHERE type = :type AND happened_at >= :from AND happened_at < :to
ORDER BY happened_at;

latestMeasurements:
SELECT * FROM measurement ORDER BY happened_at DESC LIMIT :limit;

-- The newest value of one tape site (DESIGN.md §9.1.1 needs one per region).
latestMeasurementOfType:
SELECT * FROM measurement
WHERE type = :type AND excluded_from_trends = 0
ORDER BY happened_at DESC LIMIT 1;

countMeasurements:
SELECT count(*) FROM measurement;

allMeasurements:
SELECT * FROM measurement ORDER BY happened_at;

deleteMeasurement:
DELETE FROM measurement WHERE id = :id;

insertVital:
INSERT OR IGNORE INTO vital(
    id, type, value, unit, local_date, zone_id, happened_at, recorded_at, source_id,
    method, context, note, excluded_from_trends, observation_id, raw_record_id,
    idempotency_key, device, app_version, revision
) VALUES (
    :id, :type, :value, :unit, :localDate, :zoneId, :happenedAt, :recordedAt, :sourceId,
    :method, :context, :note, :excludedFromTrends, :observationId, :rawRecordId,
    :idempotencyKey, :device, :appVersion, :revision
);

vitalById:
SELECT * FROM vital WHERE id = :id;

vitalsForDay:
SELECT * FROM vital WHERE local_date = :localDate ORDER BY happened_at;

vitalsForTypeBetween:
SELECT * FROM vital
WHERE type = :type AND happened_at >= :from AND happened_at < :to
ORDER BY happened_at;

latestVitals:
SELECT * FROM vital ORDER BY happened_at DESC LIMIT :limit;

countVitals:
SELECT count(*) FROM vital;

allVitals:
SELECT * FROM vital ORDER BY happened_at;

vitalDays:
SELECT DISTINCT local_date FROM vital ORDER BY local_date;

measurementDays:
SELECT DISTINCT local_date FROM measurement ORDER BY local_date;

deleteVital:
DELETE FROM vital WHERE id = :id;

-- Progress photos (pr.md §6.8, DESIGN.md §9.4). The bytes live in the encrypted database,
-- never in shared storage, the media gallery or a platform backup. The metadata queries
-- below never load the image; only photoById and photoThumbnailById do.
CREATE TABLE body_photo (
    id TEXT NOT NULL PRIMARY KEY,
    local_date TEXT NOT NULL,
    zone_id TEXT NOT NULL,
    happened_at INTEGER NOT NULL,
    recorded_at INTEGER NOT NULL,
    source_id TEXT NOT NULL REFERENCES source(id) ON DELETE RESTRICT,
    caption TEXT,
    notes TEXT,
    mime TEXT NOT NULL,
    width INTEGER NOT NULL,
    height INTEGER NOT NULL,
    bytes_b64 TEXT NOT NULL,
    thumb_b64 TEXT,
    sha256 TEXT NOT NULL,
    idempotency_key TEXT NOT NULL UNIQUE,
    device TEXT,
    app_version TEXT,
    revision INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX body_photo_date ON body_photo(local_date);
CREATE INDEX body_photo_happened ON body_photo(happened_at);

insertPhoto:
INSERT OR IGNORE INTO body_photo(
    id, local_date, zone_id, happened_at, recorded_at, source_id, caption, notes, mime,
    width, height, bytes_b64, thumb_b64, sha256, idempotency_key, device, app_version,
    revision
) VALUES (
    :id, :localDate, :zoneId, :happenedAt, :recordedAt, :sourceId, :caption, :notes, :mime,
    :width, :height, :bytesB64, :thumbB64, :sha256, :idempotencyKey, :device, :appVersion,
    :revision
);

photoById:
SELECT * FROM body_photo WHERE id = :id;

photoThumbnailById:
SELECT thumb_b64, bytes_b64 FROM body_photo WHERE id = :id;

photosBetween:
SELECT * FROM body_photo
WHERE local_date >= :from AND local_date <= :to
ORDER BY happened_at DESC;

latestPhotos:
SELECT * FROM body_photo ORDER BY happened_at DESC LIMIT :limit;

-- The gallery needs a date, a caption and a thumbnail, never the full image: loading every
-- full photo to draw a 110 dp tile would read megabytes per rebuild (DESIGN.md §9.4).
photoGallery:
SELECT id, local_date, happened_at, caption, thumb_b64
FROM body_photo ORDER BY happened_at DESC LIMIT :limit;

allPhotos:
SELECT * FROM body_photo ORDER BY happened_at;

countPhotos:
SELECT count(*) FROM body_photo;

deletePhoto:
DELETE FROM body_photo WHERE id = :id;
