<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Wear OS Data Layer listener (B14, ADR 0019). It exists only in the Play
         flavour, because play-services-wearable is the one Google artifact the phone
         may resolve; the F-Droid build has neither the service nor the library. -->
    <application>
        <service
            android:name="app.openhealth.android.wear.WearBridgeService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/openhealth/watch"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
