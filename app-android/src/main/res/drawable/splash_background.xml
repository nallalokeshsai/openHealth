<?xml version="1.0" encoding="utf-8"?>
<!-- The pre-API-31 starting window: one centred mark on bg, as the system splash would
     draw on API 31+ (DESIGN.md §14.2, pr.md §6.1). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/oh_bg" />
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@drawable/ic_splash_mark" />
</layer-list>
