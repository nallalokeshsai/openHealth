<?xml version="1.0" encoding="utf-8"?>
<!--
  No cleartext, ever, except the declared loopback hosts below (pr.md §6.23;
  BUILD-ROADMAP.md §B10). The app opens a socket for four explicit paths: the Open Food
  Facts barcode lookup (B6), the map-pack download (B11), the paired sync client (B13) and
  the coach's self-hosted provider adapter (B15). This file makes the rule
  explicit rather than inheriting the targetSdk default, so a future change that adds an
  http:// URL fails review instead of silently working.

  Two loopback exceptions are deliberate and narrow:
  - the sync transport allows plain http to localhost, 127.0.0.1 and the emulator host
    10.0.2.2 for a self-hoster who has not issued a certificate yet
    (docs/adr/0018-sync-server.md §6). The Ktor CIO engine does not consult this policy;
    it is enforced in KtorSyncTransport.requireSecureBase.
  - the coach's self-hosted adapter uses HttpURLConnection, which does consult this file,
    so the loopback hosts a local LM Studio/Ollama server uses are declared below
    (docs/adr/0020-ai-coach-and-mcp.md §8). No remote host is exempt.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
