<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- App lock uses the platform BiometricPrompt on API 28+ (pr.md §6.23). The
         permission is declared; it is only exercised when the person turns the lock on. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Barcode scanning (pr.md §6.3): the camera is requested at the moment the scan
         action is used, never at launch. A phone without a camera still runs the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- The one outbound call the app makes: the Open Food Facts barcode lookup the
         person asks for (pr.md §6.3, §6.23; ADR 0011). It is declared here, by the app,
         and not inherited from a library: the F-Droid flavour has no ML Kit to merge one
         in, so without this line the lookup fails on that build and silently falls back
         to the manual path. Nothing else in the app opens a socket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Nothing needs the network state: the one call is a foreground, explicit action.
         CameraX's video module (which this app never records with) merges it in, so it is
         removed here and the permission audit test holds the merged manifest to the list
         of permissions the product actually uses (`pr.md` §6.23; B10). -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- The rest timer is an ongoing foreground service (pr.md §6.5, Tech-Stack.md §4):
         health, a short rest countdown for a training session. Sound and vibration at
         zero are local alerts, never a push. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Passive step tracking (pr.md §6.6, BUILD-ROADMAP.md §B8). The activity
         permission is requested when steps are first started, never at launch. A health
         foreground service is allowed to keep a health sensor running; it is silent and
         ongoing, and it holds no wakelock. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Standard-GATT Bluetooth (pr.md §6.18). neverForLocation keeps the scan from being
         usable for location; on Android 11 and lower the scan needs the legacy pair. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Health Connect read permissions (Tech-Stack.md §8). openHealth never writes to
         the platform store. The history permission is requested only when the person
         chooses to import their history, because the platform limits a fresh grant to
         the 30 days before it. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!-- Health Connect is a system module on Android 14+ and a separate app below. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name="app.openhealth.android.OpenHealthApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenHealth">

        <activity
            android:name="app.openhealth.android.MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:theme="@style/Theme.OpenHealth.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The step counter's service (pr.md §6.6). It starts at boot when the person
             enabled tracking, and Android may refuse that launch on newer releases; the
             counter keeps counting either way and the next app start recovers it. -->
        <service
            android:name="app.openhealth.android.activity.StepTrackingService"
            android:exported="false"
            android:foregroundServiceType="health"
            android:stopWithTask="false" />

        <receiver
            android:name="app.openhealth.android.activity.StepBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The privacy rationale the Health Connect permission screen links to. -->
        <activity
            android:name="app.openhealth.android.activity.HealthRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.OpenHealth">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity="app.openhealth.android.activity.HealthRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="app.openhealth.android.training.RestTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Rest timer between strength-training sets" />
        </service>
    </application>
</manifest>
