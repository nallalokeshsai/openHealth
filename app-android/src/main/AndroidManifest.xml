<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- App lock uses the platform BiometricPrompt on API 28+ (pr.md §6.23). The
         permission is declared; it is only exercised when the person turns the lock on. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Barcode scanning (pr.md §6.3): the camera is requested at the moment the scan
         action is used, never at launch. A phone without a camera still runs the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- The rest timer is an ongoing foreground service (pr.md §6.5, Tech-Stack.md §4):
         health, a short rest countdown for a training session. Sound and vibration at
         zero are local alerts, never a push. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name="app.openhealth.android.OpenHealthApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenHealth">

        <activity
            android:name="app.openhealth.android.MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:theme="@style/Theme.OpenHealth.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="app.openhealth.android.training.RestTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Rest timer between strength-training sets" />
        </service>
    </application>
</manifest>
