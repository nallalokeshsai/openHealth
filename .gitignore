# The reference library is a local study checkout of upstream projects.
# Keep the index and manifest, but never vendor the 5+ GB of cloned code.
references/

# Dependencies and build output for the app that comes next
node_modules/
dist/
build/
coverage/
.next/
out/

# Gradle and Android local state
.gradle/
.kotlin/
captures/
*.iml

# Signing material never enters the repository (created by the owner in B10)
*.jks
*.keystore
keystore.properties

# Local health data, machine paths and secrets: never commit these.
# The `data/` directory is the storage module (Tech-Stack.md §13) and is tracked;
# local exports and generated corpora live under exports/ or build/ instead.
exports/
local-data/
# A signed Connect IQ build is a local artefact, not source.
*.prg
*.iq
watch/connectiq/bin/
.env
.env.*
!.env.example
local.properties
*.log
issues.md

# Local agent tooling (OpenCode command and permissions)
.opencode/
opencode.json

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
