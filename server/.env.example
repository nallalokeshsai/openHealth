# Copy to server/.env and change the three secrets. Never commit the real file.
OPENHEALTH_DOMAIN=localhost
OPENHEALTH_RP_ID=localhost
OPENHEALTH_ORIGIN=http://localhost:8080
OPENHEALTH_ALLOWED_USERS=owner
OPENHEALTH_ALLOW_PASSWORD=false
OPENHEALTH_DB_USER=openhealth
OPENHEALTH_DB_PASSWORD=change-me
OPENHEALTH_S3_BUCKET=openhealth-media
OPENHEALTH_S3_ACCESS_KEY=openhealth
OPENHEALTH_S3_SECRET_KEY=change-me-too
